build/
dist/
# Scratch and preserved build outputs. electron-builder writes win-unpacked plus
# installers here during QA; none of it is source, and a stray `git add -A` in a
# packaging run would otherwise commit hundreds of megabytes of binaries.
dist-*/
.vercel/
.env
.env.local
mise.local.toml
.agent_tmp/
.knoux-gen-*/

# Local agent working memory
.openhands/

# QA browser screenshots and generated reports (regenerated by browser QA scripts)
qa-evidence/browser/
qa-evidence/*.json
tools-search-results.txt

# Gradle / coverage / build caches
.gradle/
coverage/
.nyc_output/
*.log
