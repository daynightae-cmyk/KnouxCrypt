{
  "name": "knouxcrypt",
  "version": "2025.1.0",
  "description": "KnouxCrypt™ 2025 - نظام التشفير العسكري المتقدم",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "check:routes": "node scripts/check-all-routes.cjs",
    "check:audio": "node scripts/check-audio.cjs",
    "check": "npm run check:routes && npm run check:audio && npm run check:capabilities && npm run check:security && npm run test && npm run build && npm run check:desktop",
    "test": "node --test tests/*.test.cjs",
    "test:unit": "node --test tests/*.test.cjs",
    "audit:report": "npm audit --audit-level=high",
    "check:security": "node scripts/check-dependency-security.cjs",
    "check:capabilities": "node scripts/check-capabilities.cjs",
    "icons": "node scripts/generate-icons.cjs",
    "dist": "npm run build && npm run icons && electron-builder",
    "dist:win": "npm run build && npm run icons && electron-builder --win",
    "check:electron:runtime": "electron --no-sandbox --ozone-platform=headless scripts/electron-runtime-check.cjs",
    "check:electron:lifecycle": "electron --no-sandbox --ozone-platform=headless scripts/electron-lifecycle-check.cjs",
    "check:electron": "npm run check:electron:lifecycle && npm run check:electron:runtime",
    "check:desktop": "npm run check:electron && npm run icons",
    "check:browser": "node scripts/check-browser-qa.cjs"
  },
  "keywords": [
    "encryption",
    "security",
    "react",
    "glassmorphism"
  ],
  "author": "Knoux",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.6.2",
    "framer-motion": "^10.18.0",
    "hash-wasm": "^4.12.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-is-dev": "^2.0.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.knoux.knouxcrypt",
    "productName": "KnouxCrypt™ 2025",
    "copyright": "© 2025 Knoux Technologies. All rights reserved.",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "KnouxCrypt-2025-Setup-${version}-${arch}.${ext}",
      "signtoolOptions": { "publisherName": "Knoux Technologies" },
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/assets/icon.icns",
      "category": "public.app-category.security",
      "artifactName": "KnouxCrypt-2025-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.png",
      "category": "Security",
      "artifactName": "KnouxCrypt-2025-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "KnouxCrypt™ 2025",
          "Comment": "نظام التشفير العسكري المتقدم",
          "GenericName": "Encryption Software",
          "Keywords": "encryption;security;crypto;knoux;",
          "Categories": "Security;Utility;"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KnouxCrypt™ 2025",
      "include": "electron/installer.nsh",
      "artifactName": "KnouxCrypt-2025-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "menuCategory": "Security",
      "runAfterFinish": true,
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "installerHeaderIcon": "electron/assets/icon.ico",
      "warningsAsErrors": false
    },
    "dmg": {
      "title": "KnouxCrypt™ 2025 Installer",
      "icon": "electron/assets/icon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 380,
          "y": 280,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 110,
          "y": 280,
          "type": "file"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "publish": {
      "provider": "github",
      "owner": "knoux",
      "repo": "knouxcrypt"
    }
  }
}
