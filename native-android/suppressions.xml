<?xml version="1.0" encoding="UTF-8"?>
<suppressions>
    <!-- 
        Known acceptable findings for KNOUX Crypt native Android.
        Each suppression must be justified and reviewed periodically.
    -->
    
    <!-- Bouncy Castle - used for crypto operations, kept at tested version -->
    <suppress>
        <notes>Bouncy Castle 1.78 is the tested version; newer versions not yet validated for our Argon2id/X25519/Ed25519 usage</notes>
        <packageUrl regex="true">^pkg:maven/org.bouncycastle/.*@1\.78$</packageUrl>
    </suppress>

    <!-- Kotlin stdlib - part of Android platform -->
    <suppress>
        <notes>Kotlin stdlib bundled with Android Gradle Plugin; version managed by AGP</notes>
        <packageUrl regex="true">^pkg:maven/org.jetbrains.kotlin/kotlin-stdlib@.*$</packageUrl>
    </suppress>

    <!-- AndroidX libraries - managed by AGP/BOM -->
    <suppress>
        <notes>AndroidX libraries versioned via Compose BOM and AGP; CVEs in transitive deps are upstream responsibility</notes>
        <packageUrl regex="true">^pkg:maven/androidx\..*@.*$</packageUrl>
    </suppress>

    <!-- Google Guava - android implementation -->
    <suppress>
        <notes>guava-android is the Android-safe variant; no known exploitable path in our usage</notes>
        <packageUrl regex="true">^pkg:maven/com.google.guava/guava-android@.*$</packageUrl>
    </suppress>

    <!-- Kotlinx.coroutines - version pinned -->
    <suppress>
        <notes>Coroutines 1.10.2 is current stable; no known vulnerability affecting suspend/coroutineScope usage</notes>
        <packageUrl regex="true">^pkg:maven/org.jetbrains.kotlinx/kotlinx-coroutines-.*@1\.10\.2$</packageUrl>
    </suppress>

    <!-- Okio - used for I/O, version pinned -->
    <suppress>
        <notes>Okio 3.9.0 is current; no known vulnerability in our buffered I/O usage</notes>
        <packageUrl regex="true">^pkg:maven/com.squareup.okio/okio@3\.9\.0$</packageUrl>
    </suppress>

    <!-- ZXing - QR code scanning only -->
    <suppress>
        <notes>ZXing Core 3.5.3 used only for QR decode; no network exposure</notes>
        <packageUrl regex="true">^pkg:maven/com.google.zxing/core@3\.5\.3$</packageUrl>
    </suppress>

    <!-- Argon2 JVM - native JNI wrapper, version pinned -->
    <suppress>
        <notes>Argon2-jvm 2.11 wraps native Argon2id; JNI boundary isolates native code; checksum verified at build</notes>
        <packageUrl regex="true">^pkg:maven/de.mkammerer/argon2-jvm@2\.11$</packageUrl>
    </suppress>

    <!-- Room - version managed by AGP -->
    <suppress>
        <notes>Room 2.6.1 via AGP; SQLite is Android system component</notes>
        <packageUrl regex="true">^pkg:maven/androidx.room/room-.*@.*$</packageUrl>
    </suppress>

    <!-- Lifecycle/Compose - version managed by BOM -->
    <suppress>
        <notes>Lifecycle and Compose versions via Compose BOM 2025.04.01</notes>
        <packageUrl regex="true">^pkg:maven/androidx.lifecycle/.*@.*$</packageUrl>
        <packageUrl regex="true">^pkg:maven/androidx.compose/.*@.*$</packageUrl>
    </suppress>
</suppressions>