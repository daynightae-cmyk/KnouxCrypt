name: Native Android foundation
on:
  push:
    branches: [integration/knoux-crypt-android-ready-20261030]
    paths: [native-android/**, .github/workflows/native-foundation.yml]
  pull_request:
    paths: [native-android/**, .github/workflows/native-foundation.yml]
permissions:
  contents: read
concurrency:
  group: native-foundation-${{ github.ref }}
  cancel-in-progress: true
jobs:
  compile-and-jvm-tests:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v3
      - name: Install development SDK platform
        run: sdkmanager 'platforms;android-36' 'build-tools;35.0.0'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'
          cache-read-only: true
      - name: Source boundary check (not compilation)
        run: python3 native-android/scripts/check-source.py
      - name: Native compile, JVM tests and lint
        run: gradle --no-daemon -p native-android :core:security:test :app:assembleDebug :app:lintDebug --stacktrace
      - name: Preserve reports and debug APK (not release)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: native-foundation-evidence
          if-no-files-found: warn
          path: |
            native-android/core/security/build/test-results/
            native-android/core/security/build/reports/
            native-android/app/build/reports/
            native-android/app/build/outputs/apk/debug/
